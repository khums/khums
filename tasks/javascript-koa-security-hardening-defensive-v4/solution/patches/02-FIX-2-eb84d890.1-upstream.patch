From eb84d890b86011b4d8e15ba32cc3cfd39a2a02af Mon Sep 17 00:00:00 2001
From: jongleberry <jonathanrichardong@gmail.com>
Date: Sun, 6 Apr 2025 14:31:18 -0700
Subject: [PATCH] fix: don't render redirect values in anchor ref

---
 __tests__/response/redirect.js | 4 ++--
 lib/response.js                | 2 +-
 package-lock.json              | 4 ++--
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/__tests__/response/redirect.js b/__tests__/response/redirect.js
index 5ef41d133..53b475df3 100644
--- a/__tests__/response/redirect.js
+++ b/__tests__/response/redirect.js
@@ -80,7 +80,7 @@ describe('ctx.redirect(url)', () => {
       ctx.header.accept = 'text/html';
       ctx.redirect(url);
       assert.strictEqual(ctx.response.header['content-type'], 'text/html; charset=utf-8');
-      assert.strictEqual(ctx.body, `Redirecting to <a href="${url}/">${url}/</a>.`);
+      assert.strictEqual(ctx.body, `Redirecting to ${url}/.`);
     });
 
     it('should escape the url', () => {
@@ -90,7 +90,7 @@ describe('ctx.redirect(url)', () => {
       ctx.redirect(url);
       url = escape(url);
       assert.strictEqual(ctx.response.header['content-type'], 'text/html; charset=utf-8');
-      assert.strictEqual(ctx.body, `Redirecting to <a href="${url}">${url}</a>.`);
+      assert.strictEqual(ctx.body, `Redirecting to ${url}.`);
     });
   });
 
diff --git a/lib/response.js b/lib/response.js
index ae2f7bdb5..b8e2938d0 100644
--- a/lib/response.js
+++ b/lib/response.js
@@ -275,7 +275,7 @@ module.exports = {
     if (this.ctx.accepts('html')) {
       url = escape(url);
       this.type = 'text/html; charset=utf-8';
-      this.body = `Redirecting to <a href="${url}">${url}</a>.`;
+      this.body = `Redirecting to ${url}.`;
       return;
     }
 
diff --git a/package-lock.json b/package-lock.json
index 22ca2c42a..c636d2bcf 100644
--- a/package-lock.json
+++ b/package-lock.json
@@ -1,12 +1,12 @@
 {
   "name": "koa",
-  "version": "2.14.3",
+  "version": "2.15.4",
   "lockfileVersion": 2,
   "requires": true,
   "packages": {
     "": {
       "name": "koa",
-      "version": "2.14.3",
+      "version": "2.15.4",
       "license": "MIT",
       "dependencies": {
         "accepts": "^1.3.5",
