@@ -499,7 +499,7 @@ function deserializeTypedArray(
   const construct = getTypedArrayConstructor(node.c) as Int8ArrayConstructor;
   const source = deserialize(ctx, depth, node.f) as ArrayBuffer;
   const offset = node.b ?? 0;
-  if (offset < 0 || offset > source.byteLength) {
+  if (offset < 0 || offset > source.byteLength || node.l > MAX_BASE64_LENGTH) {
     throw new SerovalMalformedNodeError(node);
   }
   const result = assignIndexedValue(
@@ -517,7 +517,7 @@ function deserializeDataView(
 ): DataView {
   const source = deserialize(ctx, depth, node.f) as ArrayBuffer;
   const offset = node.b ?? 0;
-  if (offset < 0 || offset > source.byteLength) {
+  if (offset < 0 || offset > source.byteLength || node.l > MAX_BASE64_LENGTH) {
     throw new SerovalMalformedNodeError(node);
   }
   const result = assignIndexedValue(
diff --git a/packages/seroval/test/typed-array-limit.test.ts b/packages/seroval/test/typed-array-limit.test.ts
new file mode 100644
index 0000000..4a97865
--- /dev/null
+++ b/packages/seroval/test/typed-array-limit.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from 'vitest';
+import {
+  type SerovalTypedArrayNode,
+  fromCrossJSON,
+  fromJSON,
+  serialize,
+  toCrossJSON,
+  toJSON,
+} from '../src';
+
+// Same cap as the ArrayBuffer deserialization limit (MAX_BASE64_LENGTH).
+const MAX = 1_000_000;
+const INDEXED_VALUE = 4;
+
+describe('typed array length limit', () => {
+  describe('serialization', () => {
+    it('accepts a typed array at the limit', () => {
+      expect(() => serialize(new Uint8Array(MAX))).not.toThrow();
+    });
+
+    it('rejects a typed array over the limit', () => {
+      expect(() => serialize(new Uint8Array(MAX + 1))).toThrow();
+    });
+
+    it('rejects a bigint typed array over the limit', () => {
+      expect(() => serialize(new BigInt64Array(MAX + 1))).toThrow();
+    }, 30_000);
+
+    it('rejects a DataView over the limit', () => {
+      const view = new DataView(new ArrayBuffer(MAX + 1));
+      expect(() => serialize(view)).toThrow();
+    });
+  });
+
+  describe('deserialization', () => {
+    it('rejects a typed array node claiming a length over the limit', () => {
+      const ref = 703;
+      const backing = new ArrayBuffer(MAX + 1);
+      const node = toCrossJSON(new Uint8Array([1, 2, 3])) as SerovalTypedArrayNode;
+      node.f = { t: INDEXED_VALUE, i: ref } as SerovalTypedArrayNode['f'];
+      node.b = 0;
+      node.l = MAX;
+      expect(() => fromCrossJSON(node, { refs: new Map([[ref, backing]]) })).not.toThrow();
+      node.l = MAX + 1;
+      expect((() => { try { fromCrossJSON(node, { refs: new Map([[ref, backing]]) }); } catch (error) { return (error as { cause?: Error }).cause?.constructor.name; } return 'accepted'; })()).toBe('SerovalMalformedNodeError');
+    });
+
+    it('rejects a typed array node whose backing source is not a buffer', () => {
+      const json = toJSON(new Uint8Array([1, 2, 3]));
+      (json.t as SerovalTypedArrayNode).f = { t: 0, s: 64 } as SerovalTypedArrayNode['f'];
+      expect((() => { try { fromJSON(json); } catch (error) { return (error as { cause?: Error }).cause?.constructor.name; } return 'accepted'; })()).toBe('SerovalMalformedNodeError');
+    });
+  });
+});
